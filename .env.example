# Copie para .env.local (dev fora do Docker) ou .env (docker compose). Nunca commite valores reais.
# Segredos de produção e staging ficam na Vercel, não neste arquivo.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # landing
NEXT_PUBLIC_APP_URL=http://localhost:3000         # painel (em produção, app.<domínio>)

# --- Supabase (local: valores impressos por `supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                         # só servidor: webhook, jobs e agente

# --- Agente (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                                   # decidido pelos evals

# --- WhatsApp (Cloud API da Meta) ---
WHATSAPP_APP_SECRET=                               # valida a assinatura do webhook
WHATSAPP_VERIFY_TOKEN=                             # handshake do webhook
WHATSAPP_ACCESS_TOKEN=                             # número de teste da Meta em local/staging
WHATSAPP_API_VERSION=

# --- Redis (rate limit e idempotência) ---
# Local: o compose sobe um redis e o redis-http (compatível com a API do Upstash).
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=kort-local-token

# --- Fila (a definir: Vercel Queues/Workflow ou QStash) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- E-mail (Resend) ---
RESEND_API_KEY=
RESEND_FROM=kort <no-reply@exemplo.com>            # domínio verificado no Resend

# --- Observabilidade ---
SENTRY_DSN=
